#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle (standard wrapper script)
# Contax ships the official Gradle 8.9 wrapper.
#

APP_HOME=$(cd "${PRG=\"$0\"}" && pwd -P)
APP_BASE_NAME=$(basename "$APP_HOME")
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

exec "$JAVACMD" \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$@"
